library(FactoMineR)
data(tea)
sample50 <- sample(nrow(tea), 50) ##??50?Ө??ժ?
tea50 <- tea[sample50,]
teanew <- tea50[ ,c("tea.time", "Tea", "How", "sugar", "sex", "age_Q", "SPC", "frequency")]
##ncp?O???G???|???X?Ӻ???, nbelements individuals?Ӽƪ????T
tea.mca<- MCA(teanew, quali.sup = c(5:7), graph = T)
summary(tea.mca, ncp = 2, nbelements = 50)
summary(tea.mca, ncp = 3, nbelements = 50)
plot(tea.mca, invisible = c("var","quali.sup"), cex=0.7, title = "Individuals")
##?ȥX?{?D???O??descriptions
plot(tea.mca, invisible = c("ind","quali.sup"), cex=0.7, title = "Primary categories")
##?????ܸɥR?ܼƪ?description
plot(tea.mca, invisible = c("ind","var"), cex=0.7, title = "Supplementary categories")
##?X?{?Ҧ????O
plot(tea.mca, invisible = c("ind"), cex=0.7, title = "All categories")
##???????X?{
plot(tea.mca, label = c("var","quali.sup"), cex=0.7, title = "Including participants")
##?z?LselectMod?ӱ????n?X?{???ܼ?descriptions
plot(tea.mca, selectMod = c("sex","25-34","35-44","45-59","frequency","Tea"), invisible = c("ind"), cex=0.7)

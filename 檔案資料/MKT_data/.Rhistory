#install.packages("conjoint")
library(conjoint)
#smartphone <- expand.grid(CPUspeed = c("Above2GHz","Below2GHz"), Screentype = c("LCD","OLED"), Camerapixels = c("1300M","800M"), Screensize = c("5.8inch","5.2inch","4.7inch"),
#Flashmemory = c("4GB","2GB"), Waterproof = c("Yes","No"))
smartphone <- expand.grid(CPUspeed = c("Below2GHz","Above2GHz"), Screentype = c("LCD","OLED"), Camerapixels = c("800M","1300M"), Screensize = c("4.7inch","5.2inch","5.8inch"),
Flashmemory = c("2GB","4GB"), Waterproof = c("No","Yes"))
smartphone
full_design <- caFactorialDesign(data=smartphone, type="full")
print(full_design)
part_design <- caFactorialDesign(data=smartphone, type="orthogonal")
print(part_design)
code <- caEncodedDesign(part_design)
print(code)
level <- read.csv("level.csv", sep = ",", header = TRUE, colClasses=c("levels"="character"))
write.csv(part_design, file="factorial.csv", row.names=FALSE)
write.csv(code, file="encoded.csv", row.names=FALSE)
rank <- read.csv("preference1.csv", sep = ",", header = TRUE)
preference<- (nrow(code)+1 -rank)
importance <- caImportance(y=preference, x=code)
names(importance) <- names(code)
importance
caPartUtilities(y=preference, x=code, z=level)
overall_ut <- caUtilities(y=preference, x=code, z=level)
names(overall_ut) <- c('intercept', level[,1])
overall_ut
##visualization
(att <- apply(code,2,max) )
(attl <- unlist(sapply(1:length(att), function(x) rep(x , att[x]))) )
barplot(overall_ut[2:length(overall_ut)], col=attl,main="overall utility")

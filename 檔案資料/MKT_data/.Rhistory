library(stats)
library(ggplot2)
car.data<- read.csv("car_brand.csv", header=T, sep=",")
car<- car.data[,1:11]
dis_car = dist(car[,2:11],'euclidean')
mds_car = cmdscale(dis_car)
mds_car = data.frame(mds_car)
xy = cbind(mds_car, car$Brand)
names(xy)[3] <- "Brand"
ggplot(xy, aes(x=X1,y=X2,colour=factor(Brand)))+geom_point()
car.mds<- cmdscale(dis_car, k=3, eig=T)
sum((car.mds$eig[1:2])^2)/sum((car.mds$eig)^2)
carx = car.mds$points[,1]
cary = car.mds$points[,2]
plot(carx, cary, pch=1:10, col=1:10, xlab= "1st dim", ylab= "2nd dim", main="Metric_MDS")
text(carx, cary, labels = car$Brand)
